# Copy this file to .env and fill in what you need.
# Start the server with:  node --env-file=.env server.js

# --- AI brain (optional: without a key the app runs in demo mode) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
PORT=3000

# --- Privacy ---
# If set, visitors must enter this password before chatting.
APP_PASSWORD=
